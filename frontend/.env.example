# Vite build-time configuration.
# Enable the active causal volatility-serving path for production forecasts.
# It calls /api/v1/volatility/forecast and accepts 1, 5, 10, or 20 trading sessions.
VITE_VOLATILITY_SERVING_ENABLED=true

# Leave empty when the Nginx/API proxy serves /api from the same origin.
# VITE_API_URL=
