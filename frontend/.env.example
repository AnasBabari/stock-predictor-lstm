# Vite build-time configuration.
# Set false for an emergency rollback to the explicitly labelled server baseline.
VITE_BROWSER_TRAINING_ENABLED=true

# Enable the signed global volatility serving path for production forecasts.
# Set false only for rollback to the legacy compatibility path.
VITE_VOLATILITY_SERVING_ENABLED=true

# Leave empty when the Nginx/API proxy serves /api from the same origin.
# VITE_API_URL=
